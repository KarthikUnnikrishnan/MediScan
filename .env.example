# MediScan Environment Configuration
# Copy this file to .env and adjust values for your environment

SECRET_KEY=replace-with-a-secure-secret-key-in-production
DEBUG=True

# Gemini Vision OCR Configuration
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# Price Verification & Comparison Configuration
PRICE_SEARCH_PROVIDER=auto
PRICE_SEARCH_API_KEY=
PRICE_CACHE_TTL_HOURS=168
PRICE_VERIFIER_TIMEOUT=5.0
PRICE_VERIFIER_MAX_RETRIES=2
